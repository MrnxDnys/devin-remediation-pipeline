# ---- Devin API (v3 org-scoped Sessions API) ----
# Service-user credential (cog_...) with the ManageOrgSessions permission.
DEVIN_API_KEY=cog_replace_me
DEVIN_API_BASE=https://api.devin.ai/v3
DEVIN_ORG_ID=org-replace_me
# "live" calls the real Devin API; "replay" runs the in-process fake (no key needed).
DEVIN_MODE=replay
# Per-session ACU ceiling - guards the account budget. Empty = no cap.
DEVIN_MAX_ACU=10
DEVIN_PLAYBOOK_ID=playbook-id-replace-me

# ---- GitHub ----
# Fine-grained or classic PAT with repo scope on the fork (issues:write, pull_requests:read).
GITHUB_TOKEN=ghp_replace_me
GITHUB_REPO=MrnxDnys/superset
# Shared secret configured on the GitHub webhook (X-Hub-Signature-256).
GITHUB_WEBHOOK_SECRET=change_me

# ---- Orchestrator behaviour ----
DEVIN_TRIGGER_LABEL=devin-auto
DEVIN_FAILED_LABEL=devin-failed
MAX_ISSUES_PER_SCAN=5
MAX_RETRIES=1
POLL_INTERVAL_SECONDS=15
SESSION_TIMEOUT_SECONDS=1800
MAX_CONCURRENT_SESSIONS=3
ENABLE_REVIEW_GATE=true
AUTO_MERGE_ON_APPROVE=false
# Optional SCAN_TARGET_FILES / SCAN_REF / SCAN_NPM / SCAN_NPM_DIR, all have defaults

# ---- Storage ----
DB_PATH=data/state.db
